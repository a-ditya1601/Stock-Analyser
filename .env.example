# FastAPI runtime host/port and logging.
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_LOG_LEVEL=info

# PDF generation request timeout in seconds (10..1800).
REPORT_REQUEST_TIMEOUT_SECONDS=180

# Maximum in-flight report generations and queue wait before fast-fail.
MAX_CONCURRENT_REPORTS=2
REPORT_QUEUE_WAIT_SECONDS=5

# Comma-separated origins for cross-origin frontend deployments.
# Keep empty for same-origin deployments where FastAPI serves web/dist.
ALLOWED_ORIGINS=

# Optional Nvidia AI configuration for narrative only.
# Peer discovery is deterministic/local by default and does not use Nvidia.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_PEER_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_TIMEOUT_SECONDS=180
NVIDIA_PEER_TIMEOUT_SECONDS=30
NVIDIA_MAX_OUTPUT_TOKENS=4096
NVIDIA_TEMPERATURE=0.2
ENABLE_NVIDIA_NARRATIVE=0
ENABLE_NVIDIA_PEER_DISCOVERY=0

# Optional local peer universe refresh behavior.
# Build/update manually with: python -m equity_reporter.tools.refresh_universe
PEER_UNIVERSE_MARKETS=IN,US

# Optional Angel One SmartAPI credentials for Indian .NS/.BO F&O metrics.
# Leave blank to show F&O data as Data Unavailable without failing reports.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
